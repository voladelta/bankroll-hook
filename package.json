{
  "name": "bankroll-hook",
  "version": "0.1.0",
  "private": true,
  "description": "A finite fixed-odds bankroll game attached to one Uniswap v4 launch pool.",
  "license": "MIT",
  "scripts": {
    "build": "forge build && node script/check-first-party-sizes.mjs",
    "size": "node script/check-first-party-sizes.mjs",
    "test": "forge test -vvv --no-match-path 'test/fork/**'",
    "test:fork": "forge test --match-path 'test/fork/**' -vvv",
    "test:gas": "forge test --gas-report",
    "fmt": "forge fmt --check",
    "lint": "forge lint",
    "submission:configure": "node script/configure-submission.mjs"
  },
  "dependencies": {
    "@chainlink/contracts": "1.5.0",
    "@openzeppelin/contracts": "5.5.0",
    "@openzeppelin/uniswap-hooks": "1.1.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3"
  }
}
